{
  "name": "japanese-writing-textlint",
  "version": "0.1.0",
  "private": true,
  "description": "Mechanical checks used by the japanese-writing skill",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint:conversation": "textlint --config profiles/conversation.cjs",
    "lint:document": "textlint --config profiles/document.cjs",
    "mcp:conversation": "textlint --mcp --config profiles/conversation.cjs --rules-base-directory node_modules",
    "mcp:document": "textlint --mcp --config profiles/document.cjs --rules-base-directory node_modules"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fujiy/textlint-rule-preset-japanese-writing": "0.1.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-plugin-latex2e": "^1.2.1",
    "textlint-rule-ja-space-between-half-and-full-width": "^3.0.3",
    "textlint-rule-preset-ja-engineering-paper": "^1.0.4",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4"
  }
}
